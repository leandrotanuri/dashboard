# Meta Ads API
META_ACCESS_TOKEN=seu_access_token_aqui
META_AD_ACCOUNT_ID=act_000000000000000
META_APP_ID=000000000000000
META_APP_SECRET=seu_app_secret_aqui

# Google Sheets
# ID da planilha destino (encontrado na URL: docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=seu_spreadsheet_id_aqui

# Autenticação Google: gerenciada pelo gws CLI (não requer credentials.json)
# Configure uma vez com: gws auth setup && gws auth login

# Google Ads API
# Developer Token: MCC -> Ferramentas -> Configuracao -> Central de API
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token_aqui
# ID da sua MCC (Conta de Administrador), somente digitos, sem tracos
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
